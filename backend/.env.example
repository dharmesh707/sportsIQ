
# Copy this file to .env for local development.
# Never commit your real .env file.

# Local development: SQLite database.
# Production: configure your database connection string through the
# deployment environment. For Supabase, use the appropriate pooler URL.
DATABASE_URL=sqlite:///./sportsiq.db

# Development-only placeholder.
# Production requires a unique secret with at least 32 characters.
# Generate one with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-change-me-before-deploy

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated list of allowed origins.
# Local development may use "*".
# Production (DEBUG=false) requires explicit origins; wildcard is rejected.
CORS_ORIGINS=*

# true for local development.
# Production must set DEBUG=false.
DEBUG=true
