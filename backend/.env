# Copy this to .env for local dev. Never commit the real .env file.

# Local dev default is fine as-is (SQLite file in this folder).
# Production (Railway): set to the Supabase TRANSACTION POOLER string,
# port 6543 -- NOT the direct connection on port 5432. Get it from
# Supabase dashboard -> Project Settings -> Database -> Connection pooling.
DATABASE_URL=sqlite:///./sportsiq.db

# Generate a real one before deploying: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-change-me-before-deploy

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma-separated in production, e.g. your Expo dev URL + prod app scheme.
# "*" is fine for local hackathon dev, tighten before demo day if possible.
CORS_ORIGINS=*

# false in production -- gates Swagger /docs and /redoc
DEBUG=true
